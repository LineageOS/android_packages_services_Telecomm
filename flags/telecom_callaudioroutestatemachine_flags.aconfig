package: "com.android.server.telecom.flags"
container: "system"

# OWNER=tgunn TARGET=24Q3
flag {
  name: "ensure_audio_mode_updates_on_foreground_call_change"
  namespace: "telecom"
  description: "Ensure that the audio mode is updated anytime the foreground call changes."
  bug: "289861657"
}

# OWNER=tgunn TARGET=25Q2
flag {
  name: "check_device_type_on_route_change"
  namespace: "telecom"
  description: "When comparing devices on route change, also consider device type."
  bug: "388509460"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

# OWNER=tgunn TARGET=25Q2
flag {
  name: "bus_device_is_a_speaker"
  namespace: "telecom"
  description: "Treat TYPE_BUS devices like TYPE_SPEAKER"
  bug: "395647782"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

# OWNER=tjstuart TARGET=25Q4
flag {
  name: "avoid_disc_on_bt_to_bt_switch"
  namespace: "telecom"
  description: "Fix BT SCO disconnect during triangle bluetooth device switch"
  bug: "424301141"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

# OWNER=pmadapurmath TARGET=25Q4
flag {
  name: "skip_pending_msg_if_communication_device_set"
  namespace: "telecom"
  description: "Skip adding pending messages based on the value of the current communication device indicated to us by the audio fwk"
  bug: "427837546"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

# OWNER=pmadapurmath TARGET=25Q4
flag {
  name: "preserve_call_audio_routing"
  namespace: "telecom"
  description: "Preserves the call audio routing for handling active/ringing focus switches"
  bug: "410633186"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

# OWNER=pmadapurmath TARGET=25Q4
flag {
  name: "ignore_bt_broadcast"
  namespace: "telecom"
  description: "Disregards the BT broadcasts if the communication device isn't synced"
  bug: "430200812"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

# OWNER=pmadapurmath TARGET=25Q4
flag {
  name: "send_new_ringing_call_sync"
  namespace: "telecom"
  description: "Sends the new ringing call msg to the CallAudioModeStateMachine synchronously"
  bug: "437784857"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

